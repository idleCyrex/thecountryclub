# MongoDB (Atlas or self-hosted). Leave empty to run on the static content in content/*.ts
MONGODB_URI=

# Cloudinary: either the single URL ...
CLOUDINARY_URL=
# ... or the three parts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public cloud name used to build delivery URLs in the browser.
# Falls back to CLOUDINARY_CLOUD_NAME / CLOUDINARY_URL at build time when empty.
# Leave all Cloudinary vars empty to serve the local copies in public/media (npm run media).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Canonical site URL for metadata, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.countryclubpdp.com
